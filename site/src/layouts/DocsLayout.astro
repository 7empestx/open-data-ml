---
import PageLayout from '~/layouts/PageLayout.astro';
import { docsNav } from '~/navigation';
import type { MetaData } from '~/types';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
}

const { title, description, headings = [] } = Astro.props;
const metadata: MetaData = { title, description };

const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
const current = norm(Astro.url.pathname);
const toc = headings.filter((h) => h.depth === 2);

// Previous / next within the sidebar order.
const flat = docsNav.flatMap((g) => g.links);
const idx = flat.findIndex((l) => norm(l.href) === current);
const prev = idx > 0 ? flat[idx - 1] : undefined;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : undefined;
---

<PageLayout metadata={metadata}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-8 md:py-12 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,1fr)_13rem] lg:gap-10">
    <aside class="hidden lg:block" aria-label="Section navigation">
      <nav class="sticky top-24 text-sm">
        {
          docsNav.map((group) => (
            <div class="mb-6">
              <p class="mb-2 font-semibold text-heading">{group.title}</p>
              <ul class="space-y-1 border-l border-[var(--aw-color-border)]">
                {group.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class:list={[
                        '-ml-px block border-l pl-3 py-1 transition',
                        norm(l.href) === current
                          ? 'border-primary text-link font-semibold'
                          : 'border-transparent text-muted hover:text-default hover:border-gray-400',
                      ]}
                      aria-current={norm(l.href) === current ? 'page' : undefined}
                    >
                      {l.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <article class="min-w-0">
      <details class="lg:hidden mb-6 rounded-lg border border-[var(--aw-color-border)] bg-[var(--aw-color-bg-subtle)]">
        <summary class="cursor-pointer px-4 py-3 text-sm font-semibold">Browse windml pages</summary>
        <nav class="px-4 pb-3 text-sm" aria-label="Section navigation (mobile)">
          {
            docsNav.map((group) => (
              <div class="mt-2">
                <p class="font-semibold text-heading">{group.title}</p>
                <ul class="mt-1 space-y-1">
                  {group.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        class:list={['block py-1', norm(l.href) === current ? 'text-link font-semibold' : 'text-muted']}
                        aria-current={norm(l.href) === current ? 'page' : undefined}
                      >
                        {l.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>

      <h1 class="font-heading text-4xl md:text-5xl font-bold tracking-tighter leading-tighter text-heading">{title}</h1>
      {description && <p class="mt-4 text-lg text-muted max-w-3xl">{description}</p>}

      <div class="docs-prose prose md:prose-lg dark:prose-invert max-w-3xl mt-8">
        <slot />
      </div>

      {
        (prev || next) && (
          <nav class="mt-14 grid gap-4 sm:grid-cols-2 max-w-3xl not-prose" aria-label="Previous and next pages">
            {prev ? (
              <a href={prev.href} class="rounded-lg border border-[var(--aw-color-border)] p-4 hover:border-primary transition">
                <span class="block text-xs text-muted">Previous</span>
                <span class="font-semibold">{prev.text}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.href} class="rounded-lg border border-[var(--aw-color-border)] p-4 text-right hover:border-primary transition">
                <span class="block text-xs text-muted">Next</span>
                <span class="font-semibold">{next.text}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 1 && (
        <aside class="hidden xl:block" aria-label="On this page">
          <nav class="sticky top-24 text-sm">
            <p class="mb-2 font-semibold text-heading">On this page</p>
            <ul class="space-y-1.5">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-muted hover:text-default">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</PageLayout>
