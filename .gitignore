# Environments and caches (any depth)
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store

# Raw downloaded data is never committed. Only each project's data/processed/ is tracked.
projects/*/data/*
!projects/*/data/processed/
data/raw/
raw/
*.zip
*.tar.gz
*.csv.gz

# windml all-years outputs: parquets over 90 MB are not committed (rebuild with projects/windml/scripts/run_all_years.py)
projects/windml/data/processed/all_years/*_scada_10min.parquet
projects/windml/data/processed/all_years/*_scada_labeled.parquet
# extra raw signals for the all-years NBM (rebuild with projects/windml/scripts/extract_extra_signals.py)
projects/windml/data/processed/all_years/*_extra_*.parquet
# 10-min min/max/std signals for trip prediction (rebuild with projects/windml/scripts/extract_stat_signals.py)
projects/windml/data/processed/all_years/*_stats_*.parquet

# NASA C-MAPSS: license "not specified" on data.nasa.gov, so no raw or processed copies are committed.
# Fetch with projects/windml/scripts/download_cmapss.sh and rebuild locally.
**/cmapss_all.parquet
**/*cmapss*.parquet
**/*cmapss*.csv
**/nasa-cmapss/
**/CMAPSSData*

# windml logs from nohup jobs (WINDML_LOG_DIR default)
projects/windml/logs/
